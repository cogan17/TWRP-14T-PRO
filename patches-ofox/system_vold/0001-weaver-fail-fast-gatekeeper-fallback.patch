+// HyperOS keeps the LSKF in a Weaver protector backed by the NXP eSE, reached through OMAPI,
+// which recovery cannot run. It also keeps a Gatekeeper protector for the same synthetic password,
+// so try every protector that has Gatekeeper data (.secdis) when the active one fails.
+static bool Decrypt_User_Other_Protectors(const userid_t user_id, const std::string& Password) {
+	const std::string dir = "/data/system_de/" + std::to_string(user_id) + "/spblob/";
+	std::unique_ptr<DIR, int (*)(DIR*)> d(opendir(dir.c_str()), closedir);
+	if (!d)
+		return false;
+	const std::string suffix = ".secdis";
+	while (dirent* de = readdir(d.get())) {
+		std::string id = de->d_name;
+		if (id.size() <= suffix.size() || id.compare(id.size() - suffix.size(), suffix.size(), suffix) != 0)
+			continue;
+		id.resize(id.size() - suffix.size());
+		// file names are %016x, keystore aliases use %x
+		id.erase(0, std::min(id.find_first_not_of('0'), id.size() - 1));
+		printf("Trying protector '%s'\n", id.c_str());
+		if (Decrypt_User_Synth_Pass(user_id, Password, id))
+			return true;
+	}
+	return false;
+}
